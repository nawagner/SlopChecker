{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/auto_pull.py 2>/dev/null || python scripts/auto_pull.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/transcript_prompt.py 2>/dev/null || python scripts/transcript_prompt.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/upload_transcript.py 2>/dev/null || python scripts/upload_transcript.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/upload_transcript.py --push 2>/dev/null || python scripts/upload_transcript.py --push"
          }
        ]
      }
    ]
  }
}
