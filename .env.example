# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Every key here is optional: a check whose key is missing is reported as
# `skipped: missing <VAR>` in the report rather than crashing the run (see #5).

# LLM provider — powers claim extraction (#13), citation support (#11),
# budget review (#17), and the auto-generated background report (#18).
ANTHROPIC_API_KEY=

# Model for the LLM tier. Defaults to claude-opus-5 if unset.
SLOPCHECK_LLM_MODEL=

# Pangram — AI-generated text detection (#12).
PANGRAM_API_KEY=

# Crossref's REST API needs no authentication at all — this is optional.
# Setting it puts callers in Crossref's "polite pool" for faster, more
# reliable DOI resolution (#8), nothing more.
CROSSREF_MAILTO=

# Candid — prior-funding lookups against the grants dataset (#21).
CANDID_API_KEY=
