# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Every key here is optional: a check whose key is missing is reported as
# `skipped: missing <VAR>` in the report rather than crashing the run (see #5).

# LLM provider — powers claim extraction (#13), citation support (#11),
# budget review (#17), and the auto-generated background report (#18).
ANTHROPIC_API_KEY=

# Model for the LLM tier. Defaults to claude-opus-5 if unset.
SLOPCHECK_LLM_MODEL=

# Pangram — AI-generated text detection (#12).
PANGRAM_API_KEY=

# Crossref's REST API needs no authentication at all — this is optional.
# Setting it puts callers in Crossref's "polite pool" for faster, more
# reliable DOI resolution (#8), nothing more.
CROSSREF_MAILTO=

# Candid — prior-funding lookups against the grants dataset (#21).
CANDID_API_KEY=

# Cloudflare R2 — shared bulk data storage (see docs/data-storage.md).
# The account ID is an identifier, not a secret. The key pair is a secret:
# get it from Nick out-of-band, never paste it into an AI session (this
# repo commits session transcripts to a public directory).
R2_ACCOUNT_ID=8888d6a39ab3056501fe36f4d43b2ddb
R2_BUCKET=slopchecker-docs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Shared result cache — Cloudflare KV behind the Worker (see docs/kv-cache.md).
# Optional: unset means runs use the local disk cache only, which is what a
# teammate's laptop should do. Currently set on the Railway service only.
#
# The cache stores derived values only — scores, offsets, resolution status —
# never document text, and keys are hashed so it holds no record of which DOIs
# a proposal cited.
SLOPCHECK_CACHE_URL=
SLOPCHECK_CACHE_TOKEN=
